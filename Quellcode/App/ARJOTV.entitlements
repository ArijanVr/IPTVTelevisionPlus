<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Apple TV mit iCloud-Sync (Kompilierflag ICLOUD_SYNC, Anleitung: docs/ICLOUD-SYNC.md). -->
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.ch.arjo.iptelevision</string>
    </array>
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudKit</string>
    </array>
    <!-- Stille Push-Benachrichtigungen von CloudKit. Beim Export setzt Xcode «production». -->
    <key>aps-environment</key>
    <string>development</string>
    <!-- Top Shelf (Apple TV): App und Erweiterung teilen den Stand «Weiterschauen». -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.ch.arjo.iptelevision</string>
    </array>
</dict>
</plist>

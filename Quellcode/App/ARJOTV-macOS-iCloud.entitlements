<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Mac mit iCloud-Sync (Kompilierflag ICLOUD_SYNC, Anleitung: docs/ICLOUD-SYNC.md). -->
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.ch.arjo.iptelevision</string>
    </array>
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudKit</string>
    </array>
    <!-- Developer-ID-Apps (ausserhalb des App Store) müssen die Production-Umgebung fest angeben. -->
    <key>com.apple.developer.icloud-container-environment</key>
    <string>Production</string>
    <key>com.apple.developer.aps-environment</key>
    <string>production</string>
</dict>
</plist>

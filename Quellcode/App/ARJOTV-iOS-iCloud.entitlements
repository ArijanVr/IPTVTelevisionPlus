<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- iPhone/iPad mit iCloud-Sync (Kompilierflag ICLOUD_SYNC, Anleitung: docs/ICLOUD-SYNC.md). -->
    <!-- CarPlay-Video (Freigabe Case-ID 23249073) ist im Profil bisher nur für ch.arjo.tv enthalten. Vorübergehend entfernt (11.11.2026),
         bis die Berechtigung für ch.arjo.iptelevision im Developer-Portal aktiv ist. Dann wieder eintragen:
         <key>com.apple.developer.carplay-video</key><true/> -->
    <!-- Derselbe Container auf allen Plattformen; nur die private Datenbank wird verwendet. -->
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.ch.arjo.iptelevision</string>
    </array>
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudKit</string>
    </array>
    <!-- Stille Push-Benachrichtigungen von CloudKit (Änderungen anderer Geräte). Beim Export setzt Xcode «production». -->
    <key>aps-environment</key>
    <string>development</string>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.ch.arjo.iptelevision</string>
    </array>
</dict>
</plist>
